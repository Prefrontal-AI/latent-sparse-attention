+            and pre_tokenizer.get("type") == "Sequence"
+            and len(steps) == 2
+            and steps[0] == {"type": "Split", "pattern": {"Regex": PIECEWISE_PATTERN}, "behavior": "Isolated", "invert": False}
+            and steps[1].get("type") == "ByteLevel"
+            and steps[1].get("use_regex") is False
