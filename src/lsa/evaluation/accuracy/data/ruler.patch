+# A pre-tokenizer of this pattern, with no normalizer, never puts a space that follows a non-space in the same
+# piece as the character before it: no alternative matches a non-space followed by a space, and none looks
+# behind. Its token count is then the sum of the counts of the text cut at such spaces, the pieces are counted
+# in batches on every core, and a piece seen before - the haystack every search step and sample repeats - is
+# not tokenized again. The callers only take the length.
+PIECEWISE_PATTERN = r"(?i:'s|'t|'re|'ve|'m|'ll|'d)|[^\r\n\p{L}\p{N}]?\p{L}+|\p{N}{1,3}| ?[^\s\p{L}\p{N}]+[\r\n]*|\s*[\r\n]+|\s+(?!\S)|\s+"
+ANCHOR = re.compile(r"(?<=\S)(?= [A-Z])")
+PIECE = 4096
+BATCH = 256
+CACHED = 1 << 30
+
